# Installed dependencies. This workspace is linked into a DSH profile, so pnpm
# materializes the store here; neither directory belongs in version control.
node_modules/
.pnpm-store/

# Local cross-session memory store (meow-memory): SQLite database, WAL
# sidecars, session logs and debug output. Machine-local state, never shipped.
.dsh-meow/

# Logs and editor/OS scratch files.
*.log
.DS_Store
Thumbs.db
