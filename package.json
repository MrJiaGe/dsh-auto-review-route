{
  "name": "@local/dsh-auto-review-route",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Route DeepSeek Harness Auto-review requests to a user-chosen provider/model without touching the official auto-review plugin.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "1.8.6",
    "@deepseek-ai/schemastery": "3.18.5",
    "@standard-schema/spec": "1.1.0"
  }
}
